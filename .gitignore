# Session logs may contain personal context (email content, collaborator names).
logs/

# Build scratch
scratch_*.py
build_*_nb.py
unwrap.py

# LoopPlane is cloned on demand by scripts/open-dashboard.sh, not vendored here.
LoopPlane/
.loopplane/
LOOPPLANE_DASHBOARD.url

.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Never commit credentials in plaintext.
# Only the encrypted .enc blobs may be committed; everything else in secrets/ is blocked.
.env
*.key
secrets/*
!secrets/*.enc
!secrets/README.md
